{
  "name": "minecraft-ai-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.android.json",
    "test": "node --import tsx tools/run-tests.mjs",
    "validate": "node tools/validate-project.mjs",
    "build": "node tools/build.mjs",
    "build:android": "npm run typecheck && npm run validate && node tools/build.mjs --android-only",
    "check": "npm run typecheck && npm test && npm run validate && npm run build",
    "generate-schema": "node tools/generate-schema.mjs",
    "dev:companion": "node --import tsx tools/serve-companion.ts",
    "test:vision-live": "node --import tsx tools/vision-smoke.ts"
  },
  "devDependencies": {
    "@minecraft/server": "2.9.0",
    "@minecraft/server-admin": "1.0.0-beta.1.26.40-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.40-stable",
    "@minecraft/server-ui": "2.1.0",
    "@types/node": "24.5.2",
    "ajv": "8.17.1",
    "esbuild": "0.25.10",
    "minecraft-server-1-21-100": "npm:@minecraft/server@2.1.0",
    "minecraft-server-ui-1-21-100": "npm:@minecraft/server-ui@2.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
